# Server
PORT=4000
NODE_ENV=development

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGIN=http://localhost:5173

# PostgreSQL connection string
# For local dev (server running on host): use localhost
# For Docker Compose: DATABASE_URL is overridden in docker-compose.yml to use the db service hostname
DATABASE_URL=postgresql://gymtracker:gymtracker@localhost:5432/gymtracker
