# Server
PORT=4000

# CORS — comma-separated list of allowed frontend origins
# In production: ALLOWED_ORIGIN=https://your-app.railway.app
ALLOWED_ORIGIN=http://localhost:5173

# Google Sheets
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_SERVICE_ACCOUNT_EMAIL=gym-tracker-server@<project>.iam.gserviceaccount.com

# Path to the downloaded service account JSON key (relative to /server)
# Never commit this file — it is in .gitignore
GOOGLE_APPLICATION_CREDENTIALS=./credentials.json
